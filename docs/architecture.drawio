s="geometry"><Array as="points"><mxPoint x="660" y="408"/><mxPoint x="660" y="904"/></Array></mxGeometry></mxCell><mxCell id="c53" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#ED7100;fontColor=#ED7100;fontSize=11;labelBackgroundColor=#ffffff;dashed=0;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.69;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c12" target="c18"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c54" value="이미지 태그 커밋" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#2A1153;fontColor=#2A1153;fontSize=11;labelBackgroundColor=#ffffff;dashed=0;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c13" target="c4"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="565" y="150"/><mxPoint x="975" y="150"/><mxPoint x="975" y="82"/></Array></mxGeometry></mxCell><mxCell id="c55" value="Git 감시 · 동기화" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#C026D3;fontColor=#C026D3;fontSize=11;labelBackgroundColor=#ffffff;dashed=0;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="c32" target="c4"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="820" y="160"/><mxPoint x="1115" y="160"/></Array></mxGeometry></mxCell><mxCell id="c56" value="이미지 pull" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#ED7100;fontColor=#ED7100;fontSize=11;labelBackgroundColor=#ffffff;dashed=0;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.04;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="c46" target="c41"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c57" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#ED7100;fontColor=#ED7100;fontSize=11;labelBackgroundColor=#ffffff;dashed=0;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.9;entryDx=0;entryDy=0;" edge="1" parent="1" source="c46" target="c18"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="724" y="1020"/><mxPoint x="645" y="1020"/><mxPoint x="645" y="943"/></Array></mxGeometry></mxCell><mxCell id="c58" value="CI(Jenkins)는 테스트·빌드·스캔·ECR 푸시까지 맡고, CD는 Day 2에 ECS 직접 배포, Day 3~4에 매니페스트 저장소를 거쳐 Argo CD가 맡는다(GitOps).&lt;br&gt;Day 4 Jenkins는 dev 자동 배포 → prod 승인(input) → prod 배포 순서로 동작하고 서비스별 변경분만 빌드한다. ECS 스택과 EKS 클러스터는 그날 수업 종료 전 삭제, 작업용 EC2는 매일 중지하고 마지막 날 삭제한다." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#545B64;" vertex="1" parent="1"><mxGeometry x="20" y="1050" width="1260" height="40" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>